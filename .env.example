# ── SLNG ──────────────────────────────────────────────────────────────────────
SLNG_API_KEY=your_slng_api_key_here
# Required only for Talk to Tatva; set after deploying the companion agent.
SLNG_AGENT_ID=

# ── Groq (post-session analysis) ──────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ── App ───────────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173
